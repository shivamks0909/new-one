{
  "version": 2,
  "builds": [
    {
      "src": ".vercel_build/handler.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/db", "src/app/public/**"],
        "external": ["better-sqlite3"]
      }
    }
  ],
  "routes": [
    {
      "src": "/dashboard/static/(.*)",
      "dest": "/.vercel_build/handler.js"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/.vercel_build/handler.js"
    },
    {
      "src": "/static/(.*)",
      "dest": "/.vercel_build/handler.js"
    },
    {
      "src": "/(.*)",
      "dest": "/.vercel_build/handler.js"
    }
  ]
}

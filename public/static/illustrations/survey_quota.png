<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="300" height="240">
  <defs>
    <linearGradient id="bgGradQuota" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFBEB" />
      <stop offset="100%" stop-color="#FEF3C7" />
    </linearGradient>
    <linearGradient id="circleGradQuota" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B" />
      <stop offset="100%" stop-color="#D97706" />
    </linearGradient>
    <filter id="dropShadowQuota" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#D97706" flood-opacity="0.25" />
    </filter>
  </defs>

  <rect width="300" height="240" rx="20" fill="url(#bgGradQuota)" />
  <circle cx="50" cy="60" r="18" fill="#F59E0B" opacity="0.1" />
  <circle cx="250" cy="180" r="22" fill="#D97706" opacity="0.1" />
  <circle cx="250" cy="50" r="9" fill="#FBBF24" opacity="0.25" />

  <!-- Speedometer / Full Gauge Circle -->
  <circle cx="150" cy="115" r="62" fill="none" stroke="#FDE68A" stroke-width="4" stroke-dasharray="6,4" />
  <circle cx="150" cy="115" r="52" fill="url(#circleGradQuota)" filter="url(#dropShadowQuota)" />

  <!-- Meter Gauge Arc & Full Needle -->
  <path d="M128 126 A28 28 0 1 1 172 126" fill="none" stroke="#FEF3C7" stroke-width="5" stroke-linecap="round" />
  <circle cx="150" cy="120" r="5" fill="#FFFFFF" />
  <line x1="150" y1="120" x2="168" y2="104" stroke="#FFFFFF" stroke-width="4" stroke-linecap="round" />

  <!-- Bottom Banner -->
  <g transform="translate(150, 178)">
    <rect x="-70" y="0" width="140" height="28" rx="14" fill="#FFFFFF" stroke="#FEF3C7" stroke-width="1.5" />
    <text x="0" y="18" font-family="'Inter', sans-serif" font-size="11" font-weight="700" fill="#B45309" text-anchor="middle" letter-spacing="1">100% CAPACITY</text>
  </g>
</svg>
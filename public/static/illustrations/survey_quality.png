<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="300" height="240">
  <defs>
    <linearGradient id="bgGradQuality" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F5F3FF" />
      <stop offset="100%" stop-color="#EDE9FE" />
    </linearGradient>
    <linearGradient id="circleGradQuality" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B5CF6" />
      <stop offset="100%" stop-color="#6D28D9" />
    </linearGradient>
    <filter id="dropShadowQuality" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#6D28D9" flood-opacity="0.25" />
    </filter>
  </defs>

  <rect width="300" height="240" rx="20" fill="url(#bgGradQuality)" />
  <circle cx="50" cy="45" r="18" fill="#8B5CF6" opacity="0.1" />
  <circle cx="250" cy="185" r="22" fill="#6D28D9" opacity="0.1" />
  <circle cx="245" cy="55" r="9" fill="#A78BFA" opacity="0.25" />

  <!-- Shield Shape -->
  <circle cx="150" cy="115" r="62" fill="none" stroke="#DDD6FE" stroke-width="4" stroke-dasharray="6,4" />
  <circle cx="150" cy="115" r="52" fill="url(#circleGradQuality)" filter="url(#dropShadowQuality)" />

  <!-- Security Shield & Attention Exclamation -->
  <path d="M150 94 L168 102 C168 118 158 132 150 136 C142 132 132 118 132 102 Z" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linejoin="round" />
  <line x1="150" y1="104" x2="150" y2="117" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
  <circle cx="150" cy="125" r="1.8" fill="#FFFFFF" />

  <!-- Bottom Banner -->
  <g transform="translate(150, 178)">
    <rect x="-70" y="0" width="140" height="28" rx="14" fill="#FFFFFF" stroke="#DDD6FE" stroke-width="1.5" />
    <text x="0" y="18" font-family="'Inter', sans-serif" font-size="11" font-weight="700" fill="#5B21B6" text-anchor="middle" letter-spacing="1">QUALITY AUDIT</text>
  </g>
</svg>
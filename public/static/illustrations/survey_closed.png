<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 240" width="300" height="240">
  <defs>
    <linearGradient id="bgGradClosed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F8FAFC" />
      <stop offset="100%" stop-color="#E2E8F0" />
    </linearGradient>
    <linearGradient id="circleGradClosed" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#64748B" />
      <stop offset="100%" stop-color="#475569" />
    </linearGradient>
    <filter id="dropShadowClosed" x="-10%" y="-10%" width="130%" height="130%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#475569" flood-opacity="0.25" />
    </filter>
  </defs>

  <rect width="300" height="240" rx="20" fill="url(#bgGradClosed)" />
  <circle cx="55" cy="50" r="18" fill="#64748B" opacity="0.1" />
  <circle cx="245" cy="180" r="22" fill="#475569" opacity="0.1" />
  <circle cx="240" cy="50" r="9" fill="#94A3B8" opacity="0.25" />

  <!-- Clock / Lock Badge -->
  <circle cx="150" cy="115" r="62" fill="none" stroke="#CBD5E1" stroke-width="4" stroke-dasharray="6,4" />
  <circle cx="150" cy="115" r="52" fill="url(#circleGradClosed)" filter="url(#dropShadowClosed)" />

  <!-- Lock Icon -->
  <rect x="136" y="112" width="28" height="20" rx="4" fill="#FFFFFF" />
  <path d="M141 112 V105 A9 9 0 0 1 159 105 V112" fill="none" stroke="#FFFFFF" stroke-width="3.5" stroke-linecap="round" />
  <circle cx="150" cy="122" r="2" fill="#475569" />

  <!-- Bottom Banner -->
  <g transform="translate(150, 178)">
    <rect x="-70" y="0" width="140" height="28" rx="14" fill="#FFFFFF" stroke="#CBD5E1" stroke-width="1.5" />
    <text x="0" y="18" font-family="'Inter', sans-serif" font-size="11" font-weight="700" fill="#334155" text-anchor="middle" letter-spacing="1">STUDY CONCLUDED</text>
  </g>
</svg>
{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["es2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/index.ts", "src/config.ts", "src/db/**/*.ts", "src/routes/**/*.ts", "src/services/**/*.ts", "src/auth/**/*.ts", "src/validation/**/*.ts", "src/types/**/*.ts"]
}
